/* ═══════════════════════════════════════════════════════════════
   SLTCFPDI Scheduling Automation Program - QSS Stylesheet
   ═══════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────── */
QWidget {
    font-family: "Segoe UI", "Lexend", sans-serif;
    font-size: 13px;
    color: #1e293b;
}

QScrollArea QWidget {
    background-color: transparent;
    color: #1e293b;
}

QDialog QWidget {
    color: #1e293b;
}

QMainWindow {
    background-color: #f6f6f8;
}

/* ── Header ─────────────────────────────────────────────────── */
QWidget#headerWidget {
    background-color: #1152d4;
    min-height: 70px;
}

QLabel#headerTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

QLabel#headerSubtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    background: transparent;
}

/* ── Sidebar ────────────────────────────────────────────────── */
QWidget#sidebarWidget {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
    min-width: 220px;
    max-width: 220px;
}

QPushButton[class~="smallBtn"] {
    padding: 2px 12px;
    font-size: 11px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 6px;
}

QPushButton[class~="sidebarBtn"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #64748b;
    font-size: 13px;
    font-weight: 500;
    padding: 12px 16px;
    text-align: left;
}

QPushButton[class~="sidebarBtn"]:hover {
    background-color: #f1f5f9;
    color: #1152d4;
}

QPushButton[class~="sidebarBtn"][active="true"] {
    background-color: #e8eefb;
    color: #1152d4;
    font-weight: 600;
}

/* ── Cards ──────────────────────────────────────────────────── */
QFrame[class~="card"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QFrame[class~="statCard"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QLabel#statValue {
    font-size: 28px;
    font-weight: bold;
    color: #1e293b;
    background: transparent;
}

QLabel#statLabel {
    font-size: 12px;
    color: #64748b;
    font-weight: 500;
    background: transparent;
}

/* ── Buttons ────────────────────────────────────────────────── */
QPushButton[class~="primaryBtn"] {
    background-color: #1152d4;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}

QPushButton[class~="primaryBtn"]:hover {
    background-color: #0d3fa3;
}

QPushButton[class~="secondaryBtn"] {
    background-color: #ffffff;
    color: #1152d4;
    border: 1px solid #1152d4;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}

QPushButton[class~="successBtn"] {
    background-color: #22c55e;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}

/* ── Inputs ─────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1e293b;
    min-height: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #e8eefb;
    selection-color: #1152d4;
}

/* ── Tables ─────────────────────────────────────────────────── */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-weight: 600;
    font-size: 12px;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
}

/* ── Dashboard specific ────────────────────────────────────── */
QLabel#sectionTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #1e293b;
    background: transparent;
}

QLabel#mutedLabel {
    color: #94a3b8;
    font-size: 13px;
    padding: 16px 0;
    background: transparent;
}

QFrame#scheduleRow {
    background-color: #f8fafc;
    border-radius: 8px;
    padding: 12px;
    border: 1px solid #f1f5f9;
}

QLabel#schedRowName {
    font-weight: 500;
    font-size: 13px;
    color: #1e293b;
    background: transparent;
}

QLabel#schedRowDate {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QLabel#schedRowStatus {
    background-color: #e8eefb;
    color: #1152d4;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
}
